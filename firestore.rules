rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 256;
    }

    function isValidCorporateEmail(email) {
      return email is string
        && email.size() <= 160
        && (
          email.lower().matches('^[^@]+@ametaservicos\\.com\\.br$') ||
          email.lower() == 'rafael.araujo0797@gmail.com'
        );
    }

    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    match /usuarios/{uid} {
      allow read: if true;
      allow create, update: if isValidId(uid)
        && request.resource.data.keys().hasAll(['email', 'name', 'role', 'situacao'])
        && isValidCorporateEmail(request.resource.data.email);
      allow delete: if isValidId(uid);
    }

    match /nokia_sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if isValidId(siteId);
    }

    match /nokia_tssr/{rowId} {
      allow read: if true;
      allow create, update, delete: if isValidId(rowId);
    }

    match /nokia_pastas/{folderId} {
      allow read: if true;
      allow create, update, delete: if isValidId(folderId);
    }

    match /nokia_arquivos/{fileId} {
      allow read: if true;
      allow create, update, delete: if isValidId(fileId);
    }

    match /ericsson_sites/{rowId} {
      allow read: if true;
      allow create, update, delete: if isValidId(rowId);
    }

    match /ericsson_pastas/{folderId} {
      allow read: if true;
      allow create, update, delete: if isValidId(folderId);
    }

    match /ericsson_arquivos/{fileId} {
      allow read: if true;
      allow create, update, delete: if isValidId(fileId);
    }

    match /notificacoes/{notifId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notifId);
    }

    match /configuracoes/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
