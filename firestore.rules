rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCorporateEmail() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower().matches('.*@ametaservicos\\.com\\.br$') ||
        request.auth.token.email.lower() == 'rafael.araujo0797@gmail.com'
      );
    }

    function isEmailVerified() {
      return isSignedIn();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isCorporateEmail() && isEmailVerified() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'rafael.araujo0797@gmail.com' ||
          request.auth.token.email.lower() == 'rafael.araujo@ametaservicos.com.br'
        )) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
         (getUserData().get('role', '') == 'ADM' || getUserData().get('tipo', '') == 'admin' || getUserData().get('situacao', '') == 'dono'))
      );
    }

    function isReleased() {
      return isCorporateEmail() && isEmailVerified() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
         (getUserData().get('situacao', '') == 'ativo' || getUserData().get('situacao', '') == 'dono' || getUserData().get('accessReleased', false) == true))
      );
    }

    function isCoordinatorOrAdmin() {
      return isAdmin() || (
        isReleased() && (
          getUserData().get('role', '') == 'Coordenador Geral' ||
          getUserData().get('role', '') == 'Coordenador Engenharia'
        )
      );
    }

    function canAccessNokia() {
      return isAdmin() || (
        isReleased() && (
          getUserData().get('plataforma', '') == 'NOKIA' ||
          getUserData().get('plataforma', '') == 'AMBAS' ||
          getUserData().get('assignedPlatform', '') == 'NOKIA' ||
          getUserData().get('assignedPlatform', '') == 'BOTH'
        )
      );
    }

    function canAccessEricsson() {
      return isAdmin() || (
        isReleased() && (
          getUserData().get('plataforma', '') == 'ERICSSON' ||
          getUserData().get('plataforma', '') == 'AMBAS' ||
          getUserData().get('assignedPlatform', '') == 'ERICSSON' ||
          getUserData().get('assignedPlatform', '') == 'BOTH'
        )
      );
    }

    // App meta configuration
    match /app_meta/{docId} {
      allow read: if isCorporateEmail() && isEmailVerified();
      allow write: if isCorporateEmail() && isEmailVerified() && isAdmin();
    }

    // Usuarios collection
    match /usuarios/{userId} {
      // User reads their own document; released users can view directory to resolve teams/responsibles; allow unauthenticated lookup during login
      allow read: if request.auth == null || (isCorporateEmail() && (request.auth.uid == userId || isReleased()));
      
      // Strict create allowlist: user creates pending account; admin can create directly for any user
      allow create: if isCorporateEmail() && (
        (request.auth.uid == userId &&
         request.resource.data.get('uid', '') == userId &&
         request.resource.data.get('email', '').lower() == request.auth.token.email.lower() &&
         request.resource.data.keys().hasOnly(['id', 'uid', 'name', 'email', 'tipo', 'role', 'situacao', 'plataforma', 'assignedPlatform', 'accessReleased', 'documents', 'emailVerified', 'equipe', 'telefone', 'createdAt']) &&
         request.resource.data.get('tipo', 'usuario') == 'usuario' && 
         request.resource.data.get('situacao', '') == 'aguardando' && 
         request.resource.data.get('accessReleased', false) == false && 
         request.resource.data.get('role', '') != 'ADM') ||
        (isEmailVerified() && isAdmin())
      );

      // Self-update allows changing profile documents/notes. Admin can modify roles, platforms and access.
      allow update: if isCorporateEmail() && isEmailVerified() && (
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tipo', 'role', 'situacao', 'accessReleased', 'plataforma', 'assignedPlatform', 'uid', 'email'])) ||
        isAdmin()
      );
      
      // Admin can block or manage user profiles
      allow delete: if isCorporateEmail() && isEmailVerified() && isAdmin();
    }

    // Chamados collection
    match /chamados/{chamadoId} {
      allow read: if isCorporateEmail() && isReleased() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isCorporateEmail() && isReleased() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'Aberto';
      allow update: if isCorporateEmail() && isReleased() && (
        (resource.data.uid == request.auth.uid && 
         request.resource.data.uid == resource.data.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'descricao', 'titulo', 'updatedAt']) &&
         request.resource.data.status == 'Cancelado') ||
        isAdmin()
      );
      allow delete: if isCorporateEmail() && isReleased() && isAdmin();
    }

    // Platform collections (Nokia)
    match /nokia_sites/{docId} {
      allow read: if isCorporateEmail() && canAccessNokia();
      allow create, delete: if isCorporateEmail() && canAccessNokia() && isCoordinatorOrAdmin();
      allow update: if isCorporateEmail() && canAccessNokia() && (
        isCoordinatorOrAdmin() ||
        (isReleased() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['responsavelCampo', 'responsavelDemand', 'equipeParceira', 'equipe', 'responsaveisUids', 'responsaveisEmails']))
      );
    }
    match /nokia_tssr/{docId} {
      allow read, write: if isCorporateEmail() && canAccessNokia();
    }
    match /nokia_pastas/{docId} {
      allow read, write: if isCorporateEmail() && canAccessNokia();
    }
    match /nokia_arquivos/{docId} {
      allow read, write: if isCorporateEmail() && canAccessNokia();
    }

    // Platform collections (Ericsson)
    match /ericsson_sites/{docId} {
      allow read: if isCorporateEmail() && canAccessEricsson();
      allow create, delete: if isCorporateEmail() && canAccessEricsson() && isCoordinatorOrAdmin();
      allow update: if isCorporateEmail() && canAccessEricsson() && (
        isCoordinatorOrAdmin() ||
        (isReleased() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['responsavelCampo', 'responsavelDemand', 'equipeParceira', 'equipe', 'responsaveisUids', 'responsaveisEmails']))
      );
    }
    match /ericsson_pastas/{docId} {
      allow read, write: if isCorporateEmail() && canAccessEricsson();
    }
    match /ericsson_files/{docId} {
      allow read, write: if isCorporateEmail() && canAccessEricsson();
    }
    match /ericsson_arquivos/{docId} {
      allow read, write: if isCorporateEmail() && canAccessEricsson();
    }
    match /ericsson_engenharia/{docId} {
      allow read, write: if isCorporateEmail() && canAccessEricsson();
    }
    match /ericsson_reprovacoes/{docId} {
      allow read, write: if isCorporateEmail() && canAccessEricsson();
    }

    // Shared collections (Notifications and Duplas config)
    match /notificacoes/{docId} {
      allow read: if isCorporateEmail() && isReleased();
      allow write: if isCorporateEmail() && isReleased();
    }
    match /duplas_config/{docId} {
      allow read: if isCorporateEmail() && isReleased();
      allow write: if isCorporateEmail() && isCoordinatorOrAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
