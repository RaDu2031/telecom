rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'rafael.araujo@ametaservicos.com.br' ||
        request.auth.token.email.lower() == 'rafael.araujo0797@gmail.com'
      );
    }

    function isCorporateEmail() {
      return isSignedIn() && (
        isOwnerEmail() ||
        (request.auth.token.email != null && request.auth.token.email.lower().matches('.*@ametaservicos\\.com\\.br$')) ||
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
      );
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        isOwnerEmail() ||
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        isOwnerEmail() ||
        (userExists() && (
          getUserData().get('role', '') == 'ADM' || 
          getUserData().get('role', '') == 'Dono' || 
          getUserData().get('tipo', '') == 'admin' || 
          getUserData().get('situacao', '') == 'dono'
        ))
      );
    }

    function isReleased() {
      return isSignedIn() && (
        isAdmin() ||
        (userExists() && (
          getUserData().get('situacao', '') == 'ativo' || 
          getUserData().get('situacao', '') == 'dono' || 
          getUserData().get('accessReleased', false) == true
        ))
      );
    }

    function isCoordinatorOrAdmin() {
      return isAdmin() || (
        isReleased() && (
          getUserData().get('role', '') == 'Coordenador Geral' ||
          getUserData().get('role', '') == 'Coordenador Engenharia'
        )
      );
    }

    function canAccessNokia() {
      return isAdmin() || isCoordinatorOrAdmin() || (
        isReleased() && (
          getUserData().get('plataforma', '') == 'NOKIA' ||
          getUserData().get('plataforma', '') == 'AMBAS' ||
          getUserData().get('assignedPlatform', '') == 'NOKIA' ||
          getUserData().get('assignedPlatform', '') == 'BOTH'
        )
      );
    }

    function canAccessEricsson() {
      return isAdmin() || isCoordinatorOrAdmin() || (
        isReleased() && (
          getUserData().get('plataforma', '') == 'ERICSSON' ||
          getUserData().get('plataforma', '') == 'AMBAS' ||
          getUserData().get('assignedPlatform', '') == 'ERICSSON' ||
          getUserData().get('assignedPlatform', '') == 'BOTH'
        )
      );
    }

    // App meta configuration
    match /app_meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Historico de importacoes
    match /historico_importacoes/{docId} {
      allow read, write, delete: if isSignedIn() && (isAdmin() || isCoordinatorOrAdmin() || canAccessNokia() || canAccessEricsson());
    }

    // Usuarios collection
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isCoordinatorOrAdmin() || isAdmin()
      );
      
      allow create: if isSignedIn() && (isAdmin() || isOwnerEmail());

      allow update: if isSignedIn() && (
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tipo', 'role', 'situacao', 'accessReleased', 'plataforma', 'assignedPlatform', 'uid', 'email'])) ||
        isAdmin() ||
        isOwnerEmail()
      );
      
      allow delete: if isSignedIn() && (isAdmin() || isOwnerEmail());

      match /privado/{docId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isOwnerEmail());
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isOwnerEmail());
      }
    }

    // Chamados collection
    match /chamados/{chamadoId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isCoordinatorOrAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid && 
         request.resource.data.uid == resource.data.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'descricao', 'titulo', 'updatedAt']) &&
         request.resource.data.status == 'Cancelado') ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (isAdmin() || isOwnerEmail());
    }

    // Platform collections (Nokia)
    match /nokia_sites/{docId} {
      allow read: if isSignedIn() && (canAccessNokia() || isCoordinatorOrAdmin() || isAdmin());
      allow create, update, delete: if isSignedIn() && (isCoordinatorOrAdmin() || isAdmin() || canAccessNokia());
    }
    match /nokia_tssr/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessNokia() || isCoordinatorOrAdmin() || isAdmin());
    }
    match /nokia_pastas/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessNokia() || isCoordinatorOrAdmin() || isAdmin());
    }
    match /nokia_arquivos/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessNokia() || isCoordinatorOrAdmin() || isAdmin());
    }

    // Platform collections (Ericsson)
    match /ericsson_sites/{docId} {
      allow read: if isSignedIn() && (canAccessEricsson() || isCoordinatorOrAdmin() || isAdmin());
      allow create, update, delete: if isSignedIn() && (isCoordinatorOrAdmin() || isAdmin() || canAccessEricsson());
    }
    match /ericsson_pastas/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessEricsson() || isCoordinatorOrAdmin() || isAdmin());
    }
    match /ericsson_files/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessEricsson() || isCoordinatorOrAdmin() || isAdmin());
    }
    match /ericsson_arquivos/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessEricsson() || isCoordinatorOrAdmin() || isAdmin());
    }
    match /ericsson_engenharia/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessEricsson() || isCoordinatorOrAdmin() || isAdmin());
    }
    match /ericsson_reprovacoes/{docId} {
      allow read, write, delete: if isSignedIn() && (canAccessEricsson() || isCoordinatorOrAdmin() || isAdmin());
    }

    // Shared collections (Notifications and Duplas config)
    match /notificacoes/{docId} {
      allow read, write, delete: if isSignedIn();
    }
    match /duplas_config/{docId} {
      allow read: if isSignedIn();
      allow write, delete: if isSignedIn() && (isCoordinatorOrAdmin() || isAdmin());
    }

    match /acionamentos/{acionamentoId} {
      allow read: if isSignedIn() && (
        isCoordinatorOrAdmin() ||
        isAdmin() ||
        (isReleased() && request.auth.token.email.lower() in resource.data.get('destinatariosEmails', []))
      );
      allow create: if isSignedIn() && (isCoordinatorOrAdmin() || isAdmin());
      allow update: if isSignedIn() && (
        isCoordinatorOrAdmin() ||
        isAdmin() ||
        (isReleased() &&
         request.auth.token.email.lower() in resource.data.get('destinatariosEmails', []) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['status','aceitoPorEmail','aceitoPorNome','aceitoEm','atualizadoEm','historico','recusadoPorEmail','recusadoPorNome','recusadoEm','motivoRecusa','checkinEm','checkinLocal','checkoutEm','checkoutLocal','concluidoEm','resumoConclusao','pendencias']))
      );
      allow delete: if isSignedIn() && (isAdmin() || isOwnerEmail());
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
