# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Projeto: ameta-sistema-teste)
# Copie este arquivo para .env.local na sua máquina e preencha com os dados do Console do Firebase:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="ameta-sistema-teste.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ameta-sistema-teste"
VITE_FIREBASE_STORAGE_BUCKET="ameta-sistema-teste.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
