{
  "entities": {
    "Usuario": {
      "title": "Usuario",
      "description": "Documento de usuário do sistema Ameta Telecom ligado ao Firebase Authentication (usuarios/{uid}).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID do Firebase Authentication." },
        "email": { "type": "string", "format": "email", "description": "E-mail corporativo @ametaservicos.com.br." },
        "name": { "type": "string", "description": "Nome de exibição do colaborador." },
        "situacao": {
          "type": "string",
          "enum": ["dono", "aguardando", "ativo", "bloqueado"],
          "description": "Situação do acesso do usuário (novos cadastros entram como 'aguardando')."
        },
        "role": {
          "type": "string",
          "enum": ["ADM", "Coordenador Geral", "Coordenador Engenharia", "Executor", "Vistoriador"],
          "description": "Perfil operacional do usuário."
        },
        "plataforma": {
          "type": "string",
          "enum": ["NOKIA", "ERICSSON", "BOTH"],
          "description": "Plataforma liberada pelo dono (TIM/Nokia ou Ericsson)."
        },
        "assignedPlatform": {
          "type": "string",
          "enum": ["NOKIA", "ERICSSON", "BOTH"],
          "description": "Espelho de plataforma para compatibilidade com as telas."
        },
        "accessReleased": {
          "type": "boolean",
          "description": "True quando situacao for 'ativo' ou 'dono'."
        },
        "equipe": { "type": "string", "description": "Dupla/Equipe associada ao colaborador." }
      },
      "required": ["uid", "email", "name", "situacao", "role", "plataforma", "accessReleased"]
    },
    "NokiaSite": {
      "title": "NokiaSite",
      "description": "Site do sistema TIM/Nokia (ID do documento = Site ID sanitizado).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "vendor": { "type": "string", "enum": ["NOKIA"] },
        "sheetName": { "type": "string" },
        "uf": { "type": "string" },
        "municipio": { "type": "string" },
        "status": { "type": "string" },
        "equipeParceira": { "type": "string" },
        "responsavelCampo": { "type": "string" },
        "responsaveisUids": { "type": "array", "items": { "type": "string" } },
        "responsaveisEmails": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["siteId", "vendor"]
    },
    "EricssonSite": {
      "title": "EricssonSite",
      "description": "Enlace do sistema Ericsson contendo dois Site IDs (siteIdA e siteIdB), cada um com seu próprio status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteIdA": { "type": "string" },
        "siteIdB": { "type": "string" },
        "siteAVistoriaStatus": { "type": "string", "enum": ["Entregue", "Pendente", "Dispensado"] },
        "siteBVistoriaStatus": { "type": "string", "enum": ["Entregue", "Pendente", "Dispensado"] },
        "losStatus": { "type": "string", "enum": ["Entregue", "Pendente"] },
        "equipe": { "type": "string" },
        "responsaveisUids": { "type": "array", "items": { "type": "string" } },
        "responsaveisEmails": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["siteIdA", "siteIdB", "siteAVistoriaStatus", "siteBVistoriaStatus"]
    }
  },
  "firestore": {
    "/usuarios/{uid}": {
      "schema": { "$ref": "#/entities/Usuario" },
      "description": "Perfis, situações ('dono', 'aguardando', 'ativo', 'bloqueado') e plataformas dos usuários."
    },
    "/nokia_sites/{siteId}": {
      "schema": { "$ref": "#/entities/NokiaSite" },
      "description": "Coleção exclusiva de sites da plataforma TIM/Nokia."
    },
    "/ericsson_sites/{rowId}": {
      "schema": { "$ref": "#/entities/EricssonSite" },
      "description": "Coleção exclusiva de enlaces da plataforma Ericsson (com 2 Site IDs e status independentes)."
    }
  }
}
